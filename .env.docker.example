# Copiar a .env.docker. Generar secretos propios antes de arrancar.
POSTGRES_DB=sesaes
POSTGRES_USER=sesaes
# Usar un secreto hexadecimal: permite construir la URL sin caracteres reservados.
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD_POSTGRES
JWT_SECRET_KEY=REEMPLAZAR_SECRETO_JWT
JWT_EXPIRE_MINUTES=720
RESET_TOKEN_MINUTES=30
# Opcional; sin estas variables no se envían correos reales.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_NOMBRE_REMITENTE=SESAES
