DATABASE_URL=postgresql+psycopg2://sesaes:CAMBIAR_PASSWORD@localhost:5432/sesaes
JWT_SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
CORS_ORIGINS=http://localhost:4200
SESAES_ENV=development
JWT_EXPIRE_MINUTES=720
FRONTEND_BASE_URL=http://localhost:4200
SEED_DEMO_DATA=false
# Definir solo para sembrar una base sin usuarios con SEED_DEMO_DATA=true:
# SEED_DEMO_PASSWORD=
# Definir para ejecutar python -m app.init_db --superadmin:
# SUPERADMIN_BOOTSTRAP_EMAIL=
# SUPERADMIN_BOOTSTRAP_PASSWORD=
# SUPERADMIN_BOOTSTRAP_NAME=Superadministrador SESAES
# Correo opcional: Gmail SMTP SSL en smtp.gmail.com:465 (no configurar para las pruebas).
# SMTP_EMAIL=
# SMTP_APP_PASSWORD=
# SMTP_NOMBRE_REMITENTE=SESAES
# Solo pruebas de integración, nunca una BD con datos reales:
# TEST_POSTGRES_URL=postgresql+psycopg2://sesaes:CAMBIAR_PASSWORD@localhost:5432/sesaes_test

# Enlace de recuperación de contraseña enviado por SMTP (minutos):
RESET_TOKEN_MINUTES=30
# Compatibilidad POSIX: zona del proceso; la zona de negocio sigue siendo America/Santiago.
# SESAES_TZ=America/Santiago
