# Copia este archivo como backend/.env y completa los valores.
# NUNCA subas el .env real al repositorio.

# ── Base de datos ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/sesaes_db

# ── Sesión (JWT) ──────────────────────────────────────────────
# OBLIGATORIA: sin ella el backend no arranca.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
# Minutos que dura la sesión (720 = 12 horas)
JWT_EXPIRE_MINUTES=720

# ── Entorno ───────────────────────────────────────────────────
# development (por defecto) o production. En production se desactivan
# /docs, /redoc y /openapi.json.
SESAES_ENV=development

# ── CORS y enlaces ────────────────────────────────────────────
# Orígenes del frontend permitidos, separados por coma.
CORS_ORIGINS=http://localhost:4200
# URL pública del frontend (se usa en el QR de los documentos clínicos).
FRONTEND_BASE_URL=http://localhost:4200

# ── Correo (Gmail con contraseña de aplicación) ───────────────
SMTP_EMAIL=
SMTP_APP_PASSWORD=
SMTP_NOMBRE_REMITENTE=SESAES

# ── Recuperar contraseña ──────────────────────────────────────
# Minutos de validez del enlace del correo (30 por defecto).
# RESET_TOKEN_MINUTES=30

# ── Datos demo (solo desarrollo local; NUNCA en producción) ───
# SEED_DEMO_DATA=true
# SEED_DEMO_PASSWORD=

# ── Primer superadmin (python -m app.bootstrap_superadmin) ────
# SUPERADMIN_BOOTSTRAP_EMAIL=
# SUPERADMIN_BOOTSTRAP_PASSWORD=
# SUPERADMIN_BOOTSTRAP_NAME=
